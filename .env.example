# Agent Harness Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Project Management Tool Configuration
# =============================================================================

# Which project tool to use: jira | linear | clickup | github-issues
PROJECT_TOOL=jira

# Your project tool instance URL
# Jira:    https://your-company.atlassian.net
# Linear:  https://linear.app
# ClickUp: https://app.clickup.com
PROJECT_BASE_URL=https://your-instance.atlassian.net

# Project/Team identifier
# Jira:    Project key (e.g., PROJ, DEV, ENG)
# Linear:  Team key (e.g., ENG, PROD)
# ClickUp: Space ID
PROJECT_KEY=PROJ

# Your account email (used for ticket assignment)
PROJECT_USER_EMAIL=your-email@example.com

# =============================================================================
# Tool-Specific Configuration (optional overrides)
# =============================================================================

# Jira-specific (if PROJECT_TOOL=jira)
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_PROJECT_KEY=PROJ
# JIRA_USER_EMAIL=your-email@example.com

# Linear-specific (if PROJECT_TOOL=linear)
# LINEAR_API_KEY=lin_api_xxxxxxxxxxxx
# LINEAR_TEAM_KEY=ENG

# ClickUp-specific (if PROJECT_TOOL=clickup)
# CLICKUP_API_KEY=pk_xxxxxxxxxx
# CLICKUP_SPACE_ID=12345678
# CLICKUP_LIST_ID=123456789

# =============================================================================
# GitHub Configuration
# =============================================================================

# GitHub organization/username for scoped packages
GITHUB_ORG=your-org-or-username

# GitHub personal access token for API operations
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_API_KEY=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative name (both work)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# PR Review Configuration
# =============================================================================

# Directory for cloning repos during local PR reviews
# Used by: ah pr review-local
REVIEW_DIR=~/review
