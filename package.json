{
  "name": "@tonycasey/agent-harness",
  "dependencies": {
    "playwright": "^1.50.0"
  },
  "version": "0.1.16",
  "description": "Claude Code toolkit that automates repetitive developer tasks",
  "author": "Tony Casey",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "toolkit",
    "automation",
    "developer",
    "productivity"
  ],
  "bin": {
    "agent-harness": "./bin/cli.js",
    "ah": "./bin/cli.js"
  },
