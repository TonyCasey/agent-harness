    "manifest.json",
    "CLAUDE.md",
    "README.md",
    "INIT-CLAUDE.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tonycasey/agent-harness.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
